[project]
title = {TITLE}
version = 1.0

[bootstrap]
main_collection = /main/main.collectionc
render = /builtins/render/default.renderc

[input]
game_binding = /input/game.input_bindingc

[display]
width = {W}
height = {H}
high_dpi = 0
update_frequency = 0
vsync = 1

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest
max_draw_calls = 16384

[script]
shared_state = 1

[sprite]
max_count = 8192

[label]
max_count = 2048

[collection]
max_instances = 16384

[factory]
max_count = 64

[sound]
max_sound_instances = 64
max_component_count = 256

[physics]
max_collision_object_count = 0

[engine]
fixed_update_frequency = {FPS}

[native_extension]
app_manifest =
